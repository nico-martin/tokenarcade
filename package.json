{
  "name": "structured-output-game",
  "version": "0.0.1",
  "description": "An interactive token-by-token game explaining structured generation with Transformers.js",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "deploy": "node scripts/deploy.mjs",
    "lint": "eslint .",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\""
  },
  "dependencies": {
    "@huggingface/transformers": "4.3.1",
    "@huggingface/transformers-structured-output": "4.3.1",
    "lucide-react": "latest",
    "react": "latest",
    "react-dom": "latest"
  },
  "devDependencies": {
    "@eslint/js": "latest",
    "@tailwindcss/vite": "latest",
    "@trivago/prettier-plugin-sort-imports": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "@vitejs/plugin-react": "latest",
    "eslint": "latest",
    "eslint-plugin-react-hooks": "latest",
    "eslint-plugin-react-refresh": "latest",
    "globals": "latest",
    "prettier": "latest",
    "tailwindcss": "latest",
    "typescript": "^6.0.0",
    "typescript-eslint": "latest",
    "vite": "latest"
  }
}
